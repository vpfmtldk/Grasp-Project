<!--
  scene.xml : SO-ARM100 (menagerie) + table + fixed camera + a graspable cube.

  The arm has its stock parallel-jaw gripper (joint "Jaw"), which is what
  GG-CNN / GR-ConvNet predict anyway. Swap in the AmazingHand later.

  Base is mounted up + back (see robot/sim/so_arm100/so_arm100.xml, pos on the
  Base body) so the wrist can reach down to the z=0 table in front of it.
  Positions here are a first guess; iterate with the viewer / render.

  Run:  python -m robot.mujoco_backend
-->
<mujoco model="so101_grasp_scene">
  <compiler angle="radian" meshdir="so_arm100/assets/"/>
  <include file="so_arm100/so_arm100.xml"/>

  <statistic center="0 -0.05 0.1" extent="0.7"/>
  <visual>
    <global offwidth="1280" offheight="1280"/>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.35 0.5 0.7" rgb2="0 0 0" width="256" height="256"/>
    <material name="table_mat" rgba="0.95 0.95 0.95 1"/>
    <material name="cube_mat"  rgba="0.20 0.40 0.90 1"/>
  </asset>

  <worldbody>
    <light pos="0.3 -0.3 0.8" dir="-0.3 0.3 -0.8" diffuse="0.8 0.8 0.8"/>

    <!-- workspace table: 0.5 x 0.5 m, top at z = 0, in front of the arm base -->
    <body name="table" pos="0 -0.10 -0.02">
      <geom type="box" size="0.25 0.25 0.02" material="table_mat" friction="1 0.02 0.001"/>
    </body>

    <!-- fixed camera: elevated, in front, tilted down at the workspace.
         fovy is a placeholder -- set it from camera_calib.py focal length. -->
    <camera name="table_cam" pos="0 -0.55 0.42" xyaxes="1 0 0 0 0.68 0.73" fovy="58"/>

    <!-- graspable object: 3 cm cube, free body, on the table centre -->
    <body name="cube" pos="0 -0.10 0.015">
      <freejoint/>
      <geom type="box" size="0.015 0.015 0.015" material="cube_mat" mass="0.04"
            friction="1 0.05 0.001"/>
    </body>
  </worldbody>

  <keyframe>
    <!-- override the included model's keyframes for the new nq (arm 6 + cube free 7) -->
    <key name="home"
         qpos="0 -1.57 1.57 1.57 -1.57 0   0 -0.10 0.015 1 0 0 0"
         ctrl="0 -1.57 1.57 1.57 -1.57 0"/>
    <key name="look"
         qpos="0 -0.6 1.2 1.1 -1.57 0   0 -0.10 0.015 1 0 0 0"
         ctrl="0 -0.6 1.2 1.1 -1.57 0"/>
  </keyframe>
</mujoco>
